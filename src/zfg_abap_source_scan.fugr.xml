<?xml version="1.0" encoding="utf-8"?>
<abapGit version="v1.0.0" serializer="LCL_OBJECT_FUGR" serializer_version="v1.0.0">
 <asx:abap xmlns:asx="http://www.sap.com/abapxml" version="1.0">
  <asx:values>
   <AREAT>ABAP Source Scan - Core Logic (RFC)</AREAT>
   <INCLUDES>
    <SOBJ_NAME>LZFG_ABAP_SOURCE_SCANTOP</SOBJ_NAME>
    <SOBJ_NAME>SAPLZFG_ABAP_SOURCE_SCAN</SOBJ_NAME>
   </INCLUDES>
   <FUNCTIONS>
    <item>
     <FUNCNAME>Z_ABAP_SOURCE_SCAN</FUNCNAME>
     <GLOBAL_FLAG>X</GLOBAL_FLAG>
     <REMOTE_CALL>R</REMOTE_CALL>
     <SHORT_TEXT>Scan ABAP Source Code for Configurable Values</SHORT_TEXT>
     <REMOTE_BASXML>X</REMOTE_BASXML>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_SEARCH_STRING</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>ZABAP_SOURCE_SCAN-EXISTING_VALUE</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_FIELDNAME</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>ZABAP_SOURCE_SCAN-FIELDNAME</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_SCAN_PROG</PARAMETER>
       <DEFAULT>'X'</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XFELD</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_SCAN_CLAS</PARAMETER>
       <DEFAULT>'X'</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XFELD</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_SCAN_FUGR</PARAMETER>
       <DEFAULT>'X'</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XFELD</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_CASE_SENSITIVE</PARAMETER>
       <DEFAULT>SPACE</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XFELD</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_SKIP_COMMENTS</PARAMETER>
       <DEFAULT>'X'</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>XFELD</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_MAX_HITS</PARAMETER>
       <DEFAULT>10000</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>INT4</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>EV_SUBRC</PARAMETER>
       <TYP>SYSUBRC</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_MESSAGE</PARAMETER>
       <TYP>BAPI_MSG</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_LIMIT_REACHED</PARAMETER>
       <TYP>XFELD</TYP>
      </RSEXP>
     </EXPORT>
     <TABLES>
      <RSTBL>
       <PARAMETER>IT_PACKAGE</PARAMETER>
       <DBSTRUCT>ZSABAP_SCAN_SELOPT</DBSTRUCT>
       <OPTIONAL>X</OPTIONAL>
      </RSTBL>
      <RSTBL>
       <PARAMETER>ET_RESULT</PARAMETER>
       <DBSTRUCT>ZSABAP_SCAN_RESULT</DBSTRUCT>
       <OPTIONAL>X</OPTIONAL>
      </RSTBL>
     </TABLES>
    </item>
   </FUNCTIONS>
